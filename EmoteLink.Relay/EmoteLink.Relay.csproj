<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.16</Version>
    <AssemblyName>EmoteLink.Relay</AssemblyName>
    <RootNamespace>EmoteLink.Relay</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- SignalR hub DTOs are serialized dynamically; trimming can remove their metadata. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
