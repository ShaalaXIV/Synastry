<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.24</Version>
    <AssemblyName>EmoteLink.Relay</AssemblyName>
    <RootNamespace>EmoteLink.Relay</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- SignalR hub DTOs are serialized dynamically; trimming can remove their metadata. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.6" />
    <!-- Microsoft.Data.Sqlite 10.0.6 still permits the vulnerable 2.1.11 native bundle.
         Pin the serviced compatible bundle explicitly. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>
</Project>
